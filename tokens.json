{
  "$description": "Tokens de diseño de Orezco, formato DTCG. Sistema Steep — serifa editorial sobre papel cálido. Los nombres coinciden con los usados en el :root de index.html.",
  "color": {
    "ink-black":    { "$value": "#17191c", "$type": "color", "$description": "Texto principal, relleno de botón, logo. La única superficie oscura del sistema." },
    "paper-white":  { "$value": "#ffffff", "$type": "color", "$description": "Lienzo, texto de botón, superficies elevadas." },
    "mist-gray":    { "$value": "#f2f2f3", "$type": "color", "$description": "Tarjetas neutras y fondos secundarios." },
    "fog-white":    { "$value": "#fafafb", "$type": "color", "$description": "Bandas de sección alternas." },
    "slate-gray":   { "$value": "#777b86", "$type": "color", "$description": "Texto de apoyo y copy del pie." },
    "ash-gray":     { "$value": "#979799", "$type": "color", "$description": "Etiquetas de categoría. Tipográficas, sin fondo ni borde." },
    "smoke-gray":   { "$value": "#a3a6af", "$type": "color", "$description": "Marcador de campo (placeholder)." },
    "blush-peach":  { "$value": "#fbe1d1", "$type": "color", "$description": "Único color del sistema. Una tarjeta por página, y siempre sobre blanco." },
    "sienna-brown": { "$value": "#5d2a1a", "$type": "color", "$description": "Tinta del melocotón. Nunca fuera de una superficie melocotón." }
  },
  "surface": {
    "canvas":         { "$value": "{color.paper-white}", "$type": "color", "$description": "Nivel 0: fondo por defecto." },
    "card-mist":      { "$value": "{color.mist-gray}",   "$type": "color", "$description": "Nivel 1: bloques de contenido anidados." },
    "section-fog":    { "$value": "{color.fog-white}",   "$type": "color", "$description": "Nivel 2: bandas alternas." },
    "accent-blush":   { "$value": "{color.blush-peach}", "$type": "color", "$description": "Nivel 3: tarjeta de acento editorial." },
    "elevated-white": { "$value": "{color.paper-white}", "$type": "color", "$description": "Nivel 4: artefactos flotantes con sombra." }
  },
  "font": {
    "signifier": {
      "$value": "Source Serif 4",
      "$type": "fontFamily",
      "$description": "Serifa de display y titulares. SUSTITUTO: la original (Signifier) es de pago; Source Serif 4 es la alternativa que recomienda la propia referencia. Peso 400 a todos los tamaños, sin excepción."
    },
    "sohne": {
      "$value": "Inter",
      "$type": "fontFamily",
      "$description": "Sans de cuerpo, interfaz y navegación. SUSTITUTO: la original (Söhne) es de pago; Inter es la alternativa recomendada. Pesos de medio paso 430/450/480 antes de llegar a 500."
    }
  },
  "fontWeight": {
    "regular": { "$value": 400, "$type": "fontWeight" },
    "w430":    { "$value": 430, "$type": "fontWeight" },
    "w450":    { "$value": 450, "$type": "fontWeight" },
    "w480":    { "$value": 480, "$type": "fontWeight" },
    "medium":  { "$value": 500, "$type": "fontWeight" }
  },
  "typography": {
    "display":      { "$value": { "fontFamily": "{font.signifier}", "fontSize": "90px", "fontWeight": 400, "lineHeight": 1.3,  "letterSpacing": "-0.025em" }, "$type": "typography" },
    "heading-lg":   { "$value": { "fontFamily": "{font.signifier}", "fontSize": "64px", "fontWeight": 400, "lineHeight": 1.3,  "letterSpacing": "-0.015em" }, "$type": "typography" },
    "heading":      { "$value": { "fontFamily": "{font.signifier}", "fontSize": "44px", "fontWeight": 400, "lineHeight": 1.3,  "letterSpacing": "-0.015em" }, "$type": "typography" },
    "heading-sm":   { "$value": { "fontFamily": "{font.sohne}",     "fontSize": "26px", "fontWeight": 450, "lineHeight": 1.18, "letterSpacing": "-0.009em" }, "$type": "typography" },
    "subheading":   { "$value": { "fontFamily": "{font.sohne}",     "fontSize": "22px", "fontWeight": 400, "lineHeight": 1.5 },  "$type": "typography" },
    "body-lg":      { "$value": { "fontFamily": "{font.sohne}",     "fontSize": "20px", "fontWeight": 500, "lineHeight": 1.35 }, "$type": "typography" },
    "body":         { "$value": { "fontFamily": "{font.sohne}",     "fontSize": "17px", "fontWeight": 400, "lineHeight": 1.35 }, "$type": "typography" },
    "body-support": { "$value": { "fontFamily": "{font.sohne}",     "fontSize": "18px", "fontWeight": 430, "lineHeight": 1.5 },  "$type": "typography" },
    "caption":      { "$value": { "fontFamily": "{font.sohne}",     "fontSize": "15px", "fontWeight": 400, "lineHeight": 1.5 },  "$type": "typography" },
    "label":        { "$value": { "fontFamily": "{font.sohne}",     "fontSize": "14px", "fontWeight": 400, "lineHeight": 1.43 }, "$type": "typography" }
  },
  "spacing": {
    "unit": { "$value": "4px",  "$type": "dimension", "$description": "Base. Todo el espaciado es múltiplo de esta unidad." },
    "8":    { "$value": "8px",  "$type": "dimension" },
    "12":   { "$value": "12px", "$type": "dimension" },
    "16":   { "$value": "16px", "$type": "dimension" },
    "20":   { "$value": "20px", "$type": "dimension", "$description": "Relleno de tarjeta." },
    "24":   { "$value": "24px", "$type": "dimension" },
    "32":   { "$value": "32px", "$type": "dimension" },
    "40":   { "$value": "40px", "$type": "dimension" },
    "64":   { "$value": "64px", "$type": "dimension" },
    "80":   { "$value": "80px", "$type": "dimension", "$description": "Separación entre secciones." }
  },
  "layout": {
    "page-max-width": { "$value": "1200px", "$type": "dimension" },
    "section-gap":    { "$value": "80px",   "$type": "dimension" },
    "card-padding":   { "$value": "20px",   "$type": "dimension" }
  },
  "radius": {
    "cards":          { "$value": "24px",   "$type": "dimension", "$description": "Tarjetas de contenido." },
    "elevatedcards":  { "$value": "20px",   "$type": "dimension", "$description": "Artefactos flotantes." },
    "inputs":         { "$value": "16px",   "$type": "dimension" },
    "buttons":        { "$value": "9999px", "$type": "dimension", "$description": "Píldora completa. Nunca un radio intermedio." }
  },
  "shadow": {
    "subtle-3": {
      "$value": "rgba(4, 23, 43, 0.05) 0px 0px 0px 1px, rgba(0, 0, 0, 0.1) 0px 20px 25px -5px, rgba(0, 0, 0, 0.1) 0px 8px 10px -6px",
      "$type": "shadow",
      "$description": "La única sombra del sistema. Solo la llevan los artefactos flotantes; las tarjetas de contenido van planas."
    }
  },
  "$extensions": {
    "com.orezco.notas": {
      "referencia": "Steep — serif analytics on warm paper",
      "sustituciones": "Signifier y Söhne son de pago. Se usan Source Serif 4 e Inter, que es lo que recomienda la propia referencia.",
      "reglas-duras": [
        "El melocotón aparece una vez por página y siempre sobre blanco.",
        "El sienna solo se usa sobre superficie melocotón.",
        "La serifa se queda en peso 400 a todos los tamaños.",
        "Sombra solo en artefactos flotantes.",
        "Botones siempre en píldora completa y en pareja: relleno + fantasma."
      ]
    }
  }
}
