---
// El texto con su indice al lado. El indice sale de las mismas secciones
// que se van a leer, asi que no puede quedarse desfasado, y da algo util
// al carril que si no estaria vacio.
import { ancla } from "../datos/util";

interface Props {
  secciones: [string, string[]][];
}
const { secciones } = Astro.props;
const conIndice = secciones.length >= 2;
---

{
  conIndice ? (
    <div class="wrap lectura">
      <nav class="indice" aria-label="En esta página">
        <p>En esta página</p>
        <ol>
          {secciones.map(([h2]) => (
            <li>
              <a href={`#${ancla(h2)}`}>{h2}</a>
            </li>
          ))}
        </ol>
      </nav>
      <div class="prosa revela">
        {secciones.map(([h2, parrafos]) => (
          <>
            <h2 id={ancla(h2)}>{h2}</h2>
            {parrafos.map((p) => (
              <p set:html={p} />
            ))}
          </>
        ))}
      </div>
    </div>
  ) : (
    <div class="wrap estrecho prosa revela">
      {secciones.map(([h2, parrafos]) => (
        <>
          <h2>{h2}</h2>
          {parrafos.map((p) => (
            <p set:html={p} />
          ))}
        </>
      ))}
    </div>
  )
}
