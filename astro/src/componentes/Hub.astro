---
// Una pagina de area: encabezado, texto de entrada, la rejilla de lo que
// hay dentro, un dibujo y las preguntas. La usan gestoria, crecimiento,
// para quien, software y sectores.
import Encabezado from "./Encabezado.astro";
import Lectura from "./Lectura.astro";
import Tarjetas from "./Tarjetas.astro";
import Faq from "./Faq.astro";
import Cierre from "./Cierre.astro";

interface Props {
  etiqueta: string;
  titulo: string;
  entradilla: string;
  rastro: string;
  intro?: [string, string[]][];
  entradas: [string, string, string][];
  dibujo?: string;
  preguntas?: [string, string][];
  corto?: [string, string][];
}
const {
  etiqueta,
  titulo,
  entradilla,
  rastro,
  intro = [],
  entradas,
  dibujo = "",
  preguntas = [],
  corto = [],
} = Astro.props;
---

<Encabezado
  etiqueta={etiqueta}
  titulo={titulo}
  entradilla={entradilla}
  migas={[["/", "Inicio"], [null, rastro]]}
  corto={corto}
/>

{
  intro.length > 0 && (
    <section class="seccion">
      <Lectura secciones={intro} />
    </section>
  )
}

<section class="seccion">
  <div class="wrap"><Tarjetas entradas={entradas} /></div>
</section>

{
  dibujo && (
    <section class="seccion">
      <div class="wrap estrecho" set:html={dibujo} />
    </section>
  )
}

<Faq preguntas={preguntas} />

<slot />

<Cierre />
