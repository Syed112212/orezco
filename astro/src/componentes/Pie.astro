---
// El pie. Las columnas salen del mismo mapa que el menu, con dos
// anadidos que solo tienen sentido abajo: "El software" cierra la
// columna de gestoria y "Ver todo" la de recursos.
import Marca from "./Marca.astro";
import { GESTORIA, CRECIMIENTO, PUBLICO, RECURSOS, EMPRESA, LEGAL } from "../datos/mapa";

const columnas: { titulo: string; enlaces: [string, string][] }[] = [
  {
    titulo: "Gestoría",
    enlaces: [
      ...GESTORIA.map(([s, n]) => [`/gestoria/${s}`, n] as [string, string]),
      ["/funcionalidades/", "El software"],
    ],
  },
  {
    titulo: "Crecimiento",
    enlaces: CRECIMIENTO.map(([s, n]) => [`/crecimiento/${s}`, n] as [string, string]),
  },
  {
    titulo: "Para quién",
    enlaces: [
      ...PUBLICO.map(([s, n]) => [`/para/${s}`, n] as [string, string]),
      ["/sectores/", "Por sector"],
    ],
  },
  {
    titulo: "Recursos",
    enlaces: [
      ...RECURSOS.map(([s, n]) => [`/${s}`, n] as [string, string]),
      ["/recursos/", "Ver todo"],
    ],
  },
  {
    titulo: "Empresa",
    enlaces: EMPRESA.map(([s, n]) => [`/${s}`, n] as [string, string]),
  },
];

const anio = new Date().getFullYear();
---

<footer>
  <div class="wrap">
    <div class="foot-rejilla">
      <div class="foot-col">
        <div class="foot-marca">
          <Marca blanca /><span class="wordmark">cont<i>aes</i></span>
        </div>
        <p class="foot-nota">
          La gestoría de siempre, con el software dentro y gente que te ayuda a crecer.
          Contabilidad, impuestos, nóminas y contratos, más dirección financiera, captación de
          clientes, financiación y salida al exterior.
        </p>
      </div>

      {
        columnas.map((c) => (
          <nav class="foot-col" aria-label={c.titulo}>
            {/* Etiqueta de un grupo de enlaces, no titulo de contenido: como
                <h4> detras de un <h1> rompia el orden para un lector de
                pantalla. */}
            <p class="foot-titulo">{c.titulo}</p>
            {c.enlaces.map(([ruta, nombre]) => (
              <a href={ruta}>{nombre}</a>
            ))}
          </nav>
        ))
      }
    </div>

    <div class="foot-bajo">
      <small>
        &copy; {anio} Contaes &middot; Gestoría online para autónomos, startups y pymes
      </small>
      <nav aria-label="Legal" style="display:flex;gap:18px;flex-wrap:wrap">
        {LEGAL.map(([ruta, nombre]) => <a href={`/${ruta}`}>{nombre}</a>)}
      </nav>
    </div>
  </div>
</footer>
