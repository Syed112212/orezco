---
// Sin barrita de color arriba: no codificaba nada (ni orden, ni
// categoria, ni estado) y la decoracion que no significa nada es lo
// primero que hace que una pagina parezca hecha por una maquina.
interface Props {
  entradas: [string, string, string][];
  columnas?: 2 | 3;
}
const { entradas, columnas = 3 } = Astro.props;
---

<div class:list={[columnas === 3 ? "rejilla" : "rejilla-2", "revela"]}>
  {
    entradas.map(([ruta, titulo, pie]) => (
      <a class="tarjeta" href={ruta}>
        <h2 class="tarjeta-tit">{titulo}</h2>
        <p>{pie}</p>
        <span class="tarjeta-mas" aria-hidden="true">
          Ver
        </span>
      </a>
    ))
  }
</div>
