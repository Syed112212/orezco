---
// El logotipo. Dos versiones: la de color para la barra y la blanca para
// el pie, que va sobre fondo oscuro. El trazo de la C se anima solo en
// la de color; en el pie seria ruido.
interface Props {
  blanca?: boolean;
}
const { blanca = false } = Astro.props;
const c = blanca ? "#ffffff" : "#1E3A5F";
const barras = blanca
  ? ["#ffffff", "#ffffff", "#ffffff"]
  : ["#2FBF9B", "#1F9EC4", "#1E6FB8"];
---

<svg class="marca-svg" viewBox="0 0 200 200" aria-hidden="true">
  <path
    class="mc-c"
    d="M 123.56 61.80 A 55.00 55.00 0 1 0 123.56 138.20"
    fill="none"
    stroke={c}
    stroke-width="27"
    stroke-linecap="round"
  />
  <rect class="mc-b b1" x="113.0" y="59.5" width="74.0" height="19.0" rx="9.5" fill={barras[0]} />
  <rect class="mc-b b2" x="113.0" y="90.5" width="74.0" height="19.0" rx="9.5" fill={barras[1]} />
  <rect class="mc-b b3" x="113.0" y="121.5" width="62.0" height="19.0" rx="9.5" fill={barras[2]} />
</svg>
