---
// La barra, con el menu por areas. Sale del mapa del sitio, asi que
// anadir una pagina alli la anade aqui: la copia es lo que hizo que la
// portada se quedara con el menu de ayer durante semanas.
import Marca from "./Marca.astro";
import { AREAS, trazo } from "../datos/mapa";
---

<a class="skip" href="#contenido">Saltar al contenido</a>

{/* El lienzo del fondo. En una pagina interior va mas tenue, porque ahi
    se viene a leer. */}
<canvas class="fondo" id="fondo" aria-hidden="true"></canvas>

<nav class="nav" aria-label="Principal">
  <div class="nav-in">
    <a class="marca" href="/"><Marca /><span class="wordmark">cont<i>aes</i></span></a>

    <div class="nav-links" id="nav-links">
      {
        AREAS.map((area) => (
          <div class="area">
            <button type="button" aria-expanded="false">
              {area.nombre} <span class="punta" aria-hidden="true" />
            </button>
            <div class:list={["despliegue", area.doble && "doble"]}>
              {area.entradas.map(([slug, nombre, pie]) => (
                <a href={`${area.base}${slug}`}>
                  <svg class="op-ico" viewBox="0 0 24 24" aria-hidden="true">
                    <path d={trazo(slug.replace(/\/$/, ""))} />
                  </svg>
                  <span class="ml-texto">
                    <b>{nombre}</b>
                    <span>{pie}</span>
                  </span>
                </a>
              ))}
            </div>
          </div>
        ))
      }
      <a href="/precios/">Precios</a>
    </div>

    <button
      type="button"
      class="menu-btn"
      id="menu-btn"
      aria-expanded="false"
      aria-controls="nav-links"
      aria-label="Abrir el menú"
    >
      <span class="mb-linea"></span><span class="mb-linea"></span><span class="mb-linea"></span>
    </button>

    <a class="btn btn-azul" href="/demo/"
      >Hablemos <span class="flecha" aria-hidden="true">&rarr;</span></a
    >
  </div>
</nav>
