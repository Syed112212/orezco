---
// El acordeon de preguntas. La ficha para el buscador la emite la pagina
// que lo usa, con las mismas preguntas: estaban escritas por separado y
// en dos sitios se puso el HTML y no la ficha.
interface Props {
  preguntas: [string, string][];
  titulo?: string;
}
const { preguntas, titulo = "Lo que suelen preguntarnos de esto" } = Astro.props;
---

{
  preguntas.length > 0 && (
    <section class="seccion">
      <div class="wrap estrecho">
        <h2 style="margin-top:0">{titulo}</h2>
        {preguntas.map(([q, r]) => (
          <details class="tarjeta revela" style="margin-bottom:12px">
            <summary style="cursor:pointer;font-weight:600;font-size:17px;color:var(--tinta-fuerte)">
              {q}
            </summary>
            <p style="margin-top:12px;color:var(--grafito)">{r}</p>
          </details>
        ))}
      </div>
    </section>
  )
}
