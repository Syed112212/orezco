---
// La cascara comun: cabeza, barra, contenido, pie y el JS de siempre.
// Todas las paginas pasan por aqui, incluida la portada. Que la portada
// tuviera la suya propia es lo que la dejo semanas con el menu y la hoja
// de estilos de otra epoca.
import Barra from "../componentes/Barra.astro";
import Pie from "../componentes/Pie.astro";
import "../estilos/contaes.css";

interface Props {
  titulo: string;
  descripcion: string;
  /** Clase del <body>. La portada lleva "portada": el fondo va mas vivo. */
  clase?: string;
  /** Fichas de datos estructurados, ya como objetos. */
  fichas?: unknown[];
  noindex?: boolean;
  imagen?: string;
}

const {
  titulo,
  descripcion,
  clase = "",
  fichas = [],
  noindex = false,
  imagen = "/og.png",
} = Astro.props;

const url = new URL(Astro.url.pathname, Astro.site).href;
const og = new URL(imagen, Astro.site).href;
const grafo =
  fichas.length > 0
    ? JSON.stringify({ "@context": "https://schema.org", "@graph": fichas })
    : null;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={url} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <meta name="theme-color" content="#f6f5f4" />
    <meta name="google-site-verification" content="googledcdb06b2cf345b2b" />

    <link rel="icon" href="/logo.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/og.png" />

    <meta property="og:site_name" content="Contaes" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={og} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400..700&family=Quicksand:wght@600&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;1,8..60,400&display=swap"
    />

    {grafo && <script type="application/ld+json" set:html={grafo} />}
  </head>

  <body class={clase}>
    <Barra />
    <main id="contenido">
      <slot />
    </main>
    <Pie />
    <script is:inline src="/js/pie.js"></script>
  </body>
</html>
