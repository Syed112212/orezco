---
// Una pagina por modulo del software y por capacidad. Las dos comparten
// plantilla porque cuentan lo mismo: que hace, como funciona, que
// incluye, con que se conecta y que preguntan antes de contratarlo.
import Base from "../../layouts/Base.astro";
import Encabezado from "../../componentes/Encabezado.astro";
import Lectura from "../../componentes/Lectura.astro";
import Incluye from "../../componentes/Incluye.astro";
import Faq from "../../componentes/Faq.astro";
import Cierre from "../../componentes/Cierre.astro";
import modulos from "../../datos/modulos.json";
import capacidades from "../../datos/capacidades.json";
import preguntasModulo from "../../datos/preguntas-modulo.json";
import * as DP from "../../datos/diagramas";
import {
  titular,
  nombreDe,
  fichaOrganizacion,
  fichaMigas,
  fichaServicio,
  fichaFaq,
} from "../../datos/util";

type Ficha = {
  titulo: string;
  lema: string;
  entradilla: string;
  secciones: [string, string[]][];
  incluye: string[];
  conecta?: [string, string][];
  aviso?: string;
};

export function getStaticPaths() {
  const m = modulos as unknown as Record<string, Ficha>;
  const c = capacidades as unknown as Record<string, Ficha>;
  return [
    ...Object.entries(m).map(([slug, d]) => ({ params: { slug }, props: { d, esModulo: true } })),
    ...Object.entries(c).map(([slug, d]) => ({ params: { slug }, props: { d, esModulo: false } })),
  ];
}

const { slug } = Astro.params;
const { d, esModulo } = Astro.props as { d: Ficha; esModulo: boolean };

const preguntas = ((preguntasModulo as Record<string, [string, string][]>)[slug!] ??
  []) as [string, string][];

const migas: [string | null, string][] = [
  ["/", "Inicio"],
  ["/funcionalidades/", "Software"],
  [null, d.titulo],
];

// El resumen sale de lo que la pagina ya dice: ningun dato nuevo, solo
// adelantado al lado del titular para que la columna no quede vacia.
const corto: [string, string][] = [];
if (d.incluye?.length) corto.push(["Incluye", `${d.incluye.length} cosas concretas, listadas más abajo`]);
if (d.conecta?.length)
  corto.push(["Se conecta con", d.conecta.slice(0, 2).map(([s]) => nombreDe(s)).join(", ")]);

const fichas: unknown[] = [
  fichaOrganizacion(),
  fichaServicio(
    d.titulo,
    d.entradilla,
    `/funcionalidades/${slug}/`,
    esModulo ? "SoftwareApplication" : "Service",
  ),
  fichaMigas(migas),
];
if (preguntas.length) fichas.push(fichaFaq(preguntas));

const dibujo = DP.para(`funcionalidades/${slug}`);
---

<Base
  titulo={`${d.titulo} · El software · Contaes`}
  descripcion={d.entradilla.slice(0, 158)}
  fichas={fichas}
>
  <Encabezado
    etiqueta={esModulo ? "Software" : "Lo que lo hace distinto"}
    titulo={titular(d.titulo, d.lema)}
    entradilla={d.entradilla}
    migas={migas}
    corto={corto}
  />

  <section class="seccion">
    <Lectura secciones={d.secciones} />
  </section>

  {
    d.aviso && (
      <section class="seccion">
        <div class="wrap estrecho">
          <div class="aviso" set:html={d.aviso} />
        </div>
      </section>
    )
  }

  {
    dibujo && (
      <section class="seccion">
        <div class="wrap estrecho" set:html={dibujo} />
      </section>
    )
  }

  <section class="seccion banda">
    <div class="wrap revela">
      <h2 style="margin-top:0">Qué incluye</h2>
      <Incluye puntos={d.incluye} />
    </div>
  </section>

  {
    d.conecta && d.conecta.length > 0 && (
      <section class="seccion">
        <div class="wrap estrecho revela">
          <h2>Con qué se conecta</h2>
          <p class="cuerpo" style="margin-bottom:8px">
            Un módulo suelto no resuelve gran cosa. Lo que cambia el trabajo del día es que lo
            que entra por un sitio salga ya hecho por el otro.
          </p>
          <ul class="lista">
            {d.conecta.map(([s, por]) => (
              <li>
                <b>
                  <a href={`/funcionalidades/${s}/`} style="color:inherit">
                    {nombreDe(s)}
                  </a>
                </b>
                <span>{por}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <Faq preguntas={preguntas} />

  <Cierre />
</Base>
