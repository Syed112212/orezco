---
// Las tres areas: gestoria, crecimiento y para quien.
import Base from "../../layouts/Base.astro";
import Hub from "../../componentes/Hub.astro";
import areas from "../../datos/areas.json";
import { GESTORIA, CRECIMIENTO, PUBLICO, type Entrada } from "../../datos/mapa";
import * as DP from "../../datos/diagramas";
import { fichaOrganizacion, fichaMigas, fichaFaq } from "../../datos/util";

type Ficha = {
  titulo: string;
  entradilla: string;
  intro: [string, string[]][];
  preguntas: [string, string][];
};

const MAPAS: Record<string, { etiqueta: string; nombre: string; entradas: Entrada[] }> = {
  gestoria: { etiqueta: "Gestoría", nombre: "Gestoría", entradas: GESTORIA },
  crecimiento: { etiqueta: "Crecimiento", nombre: "Crecimiento", entradas: CRECIMIENTO },
  para: { etiqueta: "Para quién", nombre: "Para quién", entradas: PUBLICO },
};

export function getStaticPaths() {
  return Object.entries(areas as unknown as Record<string, Ficha>).map(([area, d]) => ({
    params: { area },
    props: { d },
  }));
}

const { area } = Astro.params;
const { d } = Astro.props as { d: Ficha };
const m = MAPAS[area!]!;
// El flujo del 303 solo va en gestoria: es donde explica algo.
const dibujo = area === "gestoria" ? DP.flujoModelo() : "";
---

<Base
  titulo={`${d.titulo} · Contaes`}
  descripcion={d.entradilla.replace(/\s+/g, " ").slice(0, 158)}
  fichas={[
    fichaOrganizacion(),
    fichaMigas([["/", "Inicio"], [null, m.nombre]]),
    ...(d.preguntas?.length ? [fichaFaq(d.preguntas)] : []),
  ]}
>
  <Hub
    etiqueta={m.etiqueta}
    titulo={d.titulo}
    entradilla={d.entradilla}
    rastro={m.nombre}
    intro={d.intro}
    entradas={m.entradas.map(([s, n, p]) => [`/${area}/${s}`, n, p])}
    dibujo={dibujo}
    preguntas={d.preguntas}
  />
</Base>
