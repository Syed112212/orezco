---
// Una pagina por servicio de gestoria, de crecimiento y por publico.
// Las tres areas comparten plantilla: cuentan lo mismo con distinta
// etiqueta, y tener tres copias es como se separan.
import Base from "../../layouts/Base.astro";
import Encabezado from "../../componentes/Encabezado.astro";
import Lectura from "../../componentes/Lectura.astro";
import Incluye from "../../componentes/Incluye.astro";
import Tarjetas from "../../componentes/Tarjetas.astro";
import Cierre from "../../componentes/Cierre.astro";
import gestoria from "../../datos/gestoria.json";
import crecimiento from "../../datos/crecimiento.json";
import para from "../../datos/para.json";
import { GESTORIA, CRECIMIENTO, PUBLICO, type Entrada } from "../../datos/mapa";
import * as DP from "../../datos/diagramas";
import { titular, fichaOrganizacion, fichaMigas, fichaServicio } from "../../datos/util";

type Ficha = {
  titulo: string;
  lema: string;
  entradilla: string;
  secciones: [string, string[]][];
  incluye: string[];
  limites: string;
};

export const AREAS: Record<
  string,
  { etiqueta: string; nombre: string; datos: Record<string, Ficha>; mapa: Entrada[] }
> = {
  gestoria: {
    etiqueta: "Gestoría",
    nombre: "Gestoría",
    datos: gestoria as unknown as Record<string, Ficha>,
    mapa: GESTORIA,
  },
  crecimiento: {
    etiqueta: "Crecimiento",
    nombre: "Crecimiento",
    datos: crecimiento as unknown as Record<string, Ficha>,
    mapa: CRECIMIENTO,
  },
  para: {
    etiqueta: "Para quién",
    nombre: "Para quién",
    datos: para as unknown as Record<string, Ficha>,
    mapa: PUBLICO,
  },
};

export function getStaticPaths() {
  return Object.entries(AREAS).flatMap(([area, a]) =>
    Object.entries(a.datos).map(([slug, d]) => ({ params: { area, slug }, props: { d } })),
  );
}

const { area, slug } = Astro.params;
const { d } = Astro.props as { d: Ficha };
const a = AREAS[area!]!;

const migas: [string | null, string][] = [
  ["/", "Inicio"],
  [`/${area}/`, a.nombre],
  [null, d.titulo],
];

const corto: [string, string][] = [];
if (d.incluye?.length) corto.push(["Incluye", `${d.incluye.length} cosas concretas, listadas más abajo`]);
if (d.limites) corto.push(["Y además", "decimos para quién no es"]);
if (area === "gestoria") corto.push(["Quién firma", "un asesor colegiado, con su nombre"]);

const hermanas = a.mapa.filter(([s]) => s.replace(/\/$/, "") !== slug).slice(0, 3);

const dibujo = DP.para(`${area}/${slug}`);
---

<Base
  titulo={`${d.titulo} · ${a.nombre} · Contaes`}
  descripcion={d.entradilla.slice(0, 158)}
  fichas={[
    fichaOrganizacion(),
    fichaServicio(d.titulo, d.entradilla, `/${area}/${slug}/`),
    fichaMigas(migas),
  ]}
>
  <Encabezado
    etiqueta={a.etiqueta}
    titulo={titular(d.titulo, d.lema)}
    entradilla={d.entradilla}
    migas={migas}
    corto={corto.slice(0, 3)}
  />

  <section class="seccion">
    <Lectura secciones={d.secciones} />
  </section>

  {
    dibujo && (
      <section class="seccion">
        <div class="wrap estrecho" set:html={dibujo} />
      </section>
    )
  }

  <section class="seccion banda">
    <div class="wrap revela">
      <h2 style="margin-top:0">Qué incluye</h2>
      <Incluye puntos={d.incluye} />
    </div>
  </section>

  <section class="seccion">
    <div class="wrap">
      <div class="panel medianoche revela">
        <p class="etiqueta" style="color:#8b93b5;margin-bottom:12px">Con franqueza</p>
        <h2 style="margin:0 0 14px;max-width:20ch">Para quién no es</h2>
        <p class="cuerpo" style="max-width:64ch;font-size:17px" set:html={d.limites} />
      </div>
    </div>
  </section>

  <section class="seccion">
    <div class="wrap revela">
      <p class="etiqueta" style="margin-bottom:10px">Del mismo bloque</p>
      <h2 style="margin-top:0">También te puede interesar</h2>
      <Tarjetas entradas={hermanas.map(([s, n, p]) => [`/${area}/${s}`, n, p])} />
    </div>
  </section>

  <Cierre />
</Base>
