---
// Las tres paginas legales. El texto va tal cual esta redactado: es
// texto juridico, y reescribirlo al portarlo es como se pierde una
// clausula sin que nadie lo note.
import Base from "../../layouts/Base.astro";
import legales from "../../datos/legales.json";

type Ficha = { titulo: string; descripcion: string; html: string };

export function getStaticPaths() {
  return Object.entries(legales as unknown as Record<string, Ficha>).map(([slug, d]) => ({
    params: { slug },
    props: { d },
  }));
}
const { d } = Astro.props as { d: Ficha };
---

<Base titulo={d.titulo} descripcion={d.descripcion}>
  <Fragment set:html={d.html} />
</Base>
