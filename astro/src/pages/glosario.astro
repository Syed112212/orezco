---
// El glosario. Cada termino es una ficha DefinedTerm: un glosario sin
// datos estructurados es una lista larga que el buscador no entiende.
import Base from "../layouts/Base.astro";
import Encabezado from "../componentes/Encabezado.astro";
import Cierre from "../componentes/Cierre.astro";
import glosario from "../datos/glosario.json";
import { ancla, fichaOrganizacion, fichaMigas } from "../datos/util";

// [termino, categoria, definicion]
const terminos = (glosario as [string, string, string][])
  .slice()
  .sort((a, b) => a[0].localeCompare(b[0], "es"));
const letras = [...new Set(terminos.map(([t]) => t[0]!.toUpperCase()))];

const fichaGlosario = {
  "@type": "DefinedTermSet",
  name: "Glosario de contabilidad y fiscalidad",
  url: "https://contaes.com/glosario/",
  hasDefinedTerm: terminos.map(([t, , d]) => ({
    "@type": "DefinedTerm",
    name: t,
    description: d.replace(/<[^>]+>/g, ""),
  })),
};
---

<Base
  titulo="Glosario · Contaes"
  descripcion="Los términos de contabilidad, fiscalidad y laboral que aparecen en cualquier conversación con una gestoría, explicados sin rodeos."
  fichas={[fichaOrganizacion(), fichaGlosario, fichaMigas([["/", "Inicio"], [null, "Glosario"]])]}
>
  <Encabezado
    etiqueta="Recursos"
    titulo="Glosario"
    entradilla="Los términos que aparecen en cualquier conversación con una gestoría, explicados sin rodeos y sin dar por sabido nada."
    migas={[["/", "Inicio"], [null, "Glosario"]]}
    corto={[
      ["Términos", `${terminos.length} definidos`],
      ["Para qué", "entender lo que te dicen sin tener que preguntar"],
    ]}
  />

  <section class="seccion">
    <div class="wrap">
      <nav class="filtros" aria-label="Ir a una letra">
        {letras.map((l) => <a class="filtro" href={`#l-${l}`}>{l}</a>)}
      </nav>
      <dl class="glosario">
        {
          terminos.map(([t, cat, d]) => (
            <div class="termino" id={`t-${ancla(t)}`}>
              <dt id={`l-${t[0]!.toUpperCase()}`}>{t}<span class="term-cat">{cat}</span></dt>
              <dd set:html={d} />
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <Cierre />
</Base>
