---
// Una pagina por sector. No repite lo que ya cuentan las de servicio:
// dice que duele en ese sector concreto, que cambia, y las tres
// preguntas que hariamos en la primera llamada.
import Base from "../../layouts/Base.astro";
import Encabezado from "../../componentes/Encabezado.astro";
import Tarjetas from "../../componentes/Tarjetas.astro";
import Faq from "../../componentes/Faq.astro";
import Cierre from "../../componentes/Cierre.astro";
import sectores from "../../datos/sectores.json";
import modulos from "../../datos/modulos.json";
import capacidades from "../../datos/capacidades.json";
import * as DP from "../../datos/diagramas";
import {
  titular,
  nombreDe,
  fichaOrganizacion,
  fichaMigas,
  fichaServicio,
  fichaFaq,
} from "../../datos/util";

type Ficha = {
  titulo: string;
  lema: string;
  entradilla: string;
  duele: string[];
  aporta: [string, string][];
  preguntas: [string, string][];
  modulos: string[];
};

export function getStaticPaths() {
  return Object.entries(sectores as unknown as Record<string, Ficha>).map(([slug, d]) => ({
    params: { slug },
    props: { d },
  }));
}

const { slug } = Astro.params;
const { d } = Astro.props as { d: Ficha };

const lemas = { ...modulos, ...capacidades } as unknown as Record<string, { lema: string }>;
const migas: [string | null, string][] = [
  ["/", "Inicio"],
  ["/sectores/", "Sectores"],
  [null, d.titulo],
];
const dibujo = DP.para(`sectores/${slug}`);
---

<Base
  titulo={`Gestoría y software para ${d.titulo.toLowerCase()} · Contaes`}
  descripcion={d.entradilla.slice(0, 158)}
  fichas={[
    fichaOrganizacion(),
    fichaServicio(
      `Gestoría y software para ${d.titulo.toLowerCase()}`,
      d.entradilla,
      `/sectores/${slug}/`,
    ),
    fichaMigas(migas),
    ...(d.preguntas?.length ? [fichaFaq(d.preguntas)] : []),
  ]}
>
  <Encabezado
    etiqueta="Sectores"
    titulo={titular(d.titulo, d.lema)}
    entradilla={d.entradilla}
    migas={migas}
    corto={[
      ["Lo que duele", `${d.duele.length} cosas que salen en cada llamada`],
      ["Qué cambia", `${d.aporta.length} respuestas concretas`],
      ["Módulos", `${d.modulos.length} llevan el peso aquí`],
    ]}
  />

  <section class="seccion">
    <div class="wrap estrecho revela prosa">
      <h2 style="margin-top:0">Lo que suele doler</h2>
      <ul>{d.duele.map((x) => <li set:html={x} />)}</ul>
    </div>
  </section>

  {
    dibujo && (
      <section class="seccion">
        <div class="wrap estrecho" set:html={dibujo} />
      </section>
    )
  }

  <section class="seccion">
    <div class="wrap estrecho revela">
      <h2>Qué cambia con Contaes</h2>
      <ul class="lista">
        {
          d.aporta.map(([t, x]) => (
            <li>
              <b>{t}</b>
              <span>{x}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Faq preguntas={d.preguntas ?? []} titulo="Lo que preguntamos en la primera llamada" />

  <section class="seccion">
    <div class="wrap revela">
      <h2>Los módulos que más se usan aquí</h2>
      <p class="cuerpo" style="margin-bottom:22px">
        Están todos disponibles; estos son los que llevan el peso en este sector.
      </p>
      <Tarjetas
        entradas={d.modulos.map((s) => [
          `/funcionalidades/${s}/`,
          nombreDe(s),
          lemas[s]?.lema ?? "",
        ])}
      />
    </div>
  </section>

  <Cierre
    titulo="¿Se parece a lo vuestro?"
    texto="En la primera llamada preferimos escuchar cómo trabajáis antes que enseñar pantallas. Si no encajamos, se dice ahí."
  />
</Base>
